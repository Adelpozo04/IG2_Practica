particle_system SmokeParticleWhite{
    billboard_type point
    particle_width 10
    particle_height 10
    quota 1000
    material Smoke
    emitter Point
    {
        // Configuración del emisor
        emission_rate 100
        angle 20
        direction 0 -1 0
        colour 1 1 1 1
        time_to_live 5
        velocity_min 150 
        velocity_max 200
    }
    affector Rotator{
    // Configuración del modificador
    rotation_speed_range_end 1
     rotation_range_end 3
    }
}

particle_system SmokeParticleGray{
    billboard_type point
    particle_width 10
    particle_height 10
    quota 1000
    material Smoke
    emitter Point
    {
        // Configuración del emisor
        emission_rate 100
        angle 20
        direction 0 -1 0
        colour 0.5 0.5 0.5 1
        time_to_live 5
        velocity_min 150 
        velocity_max 200
    }
    affector Rotator{
    // Configuración del modificador
    rotation_speed_range_end 1
     rotation_range_end 3
    }
}

particle_system FireParticle{
    billboard_type point
    particle_width 35
    particle_height 35
    quota 500
    material Smoke
    emitter Point
    {
        // Configuración del emisor
        emission_rate 100
        angle 40
        direction 0 -1 0
        time_to_live 4
        velocity_min 150 
        velocity_max 180
    }
    affector Rotator{
    // Configuración del modificador
     rotation_speed_range_end 1
     rotation_range_end 5
    }
    affector ColourImage{
        image smokecolors.png
    }
}