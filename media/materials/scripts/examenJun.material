
material bodyJun{
    technique{
        pass{
            texture_unit{
                texture corrosion.jpg
            }
        }
    }
}

material wingJun{
    technique{
        pass{
            texture_unit{
                texture RustySteel.jpg
            }
        }
    }
}

material engineJun{
    technique{
        pass{

            lighting off

            texture_unit{
                texture MtlPlat2.jpg
            }
        }
    }
}

material rocketJun{
    technique{
        pass{
                texture_unit{
                    texture BumpyMetal.jpg 
                }
        }
    }  
}

material floorJun{
    technique{
        pass{
            texture_unit{
                texture Water01.jpg
                colour_op modulate
            }

            texture_unit{
                texture Noise.png
                colour_op modulate
                scroll_anim 0.1 0.1
            }
        }
    }
}

material skyJun{
    technique{
        pass{
            texture_unit{
                texture spaceSky.jpg
            }
        }
    }
}

material smokeJun{
    technique{
        pass{

            lighting off
            scene_blend alpha_blend
            depth_write off
            diffuse vertexcolour

            texture_unit{
                texture smoke.png
                tex_address_mode clamp
            }
        }
    }
}