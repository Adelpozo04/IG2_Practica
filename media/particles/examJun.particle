particle_system whiteSmokeJun{
    billboard_type point
    particle_width 10
    particle_height 10
    quota 1000
    material smokeJun

    emitter Point{
        direction 1 0 0
        position 0 0 0
        angle 20
        emission_rate 50
        time_to_live 10
        velocity_min 150
        velocity_max 200
        colour 1 1 1 1
        duration 120
    }

    affector ColourFader{
        red 0.06
        green 0.06
        blue 0.06
        alpha -0.06
    }

    affector Scaler{
        rate 50
    }
}

particle_system graySmokeJun{
    billboard_type point
    particle_width 10
    particle_height 10
    quota 1000
    material smokeJun
    
    emitter Point{
        direction 1 0 0
        position 0 0 0
        angle 20
        emission_rate 50
        time_to_live 10
        velocity_min 150
        velocity_max 200
        colour 0.4 0.4 0.4 1
        duration 120
    }

    affector ColourFader{
        red 0.06
        green 0.06
        blue 0.06
        alpha -0.06
    }

    affector Scaler{
        rate 50
    }
}

particle_system fireSmokeJun{
    billboard_type point
    particle_width 35
    particle_height 35
    quota 500
    material smokeJun
    
    emitter Point{
        direction 1 0 0
        position 0 0 0
        angle 20
        emission_rate 50
        time_to_live 6
        velocity_min 150
        velocity_max 180
        colour 0.4 0.4 0.4 1
        duration 120
    }

    affector ColourImage{
        image smokecolors.png
    }
}